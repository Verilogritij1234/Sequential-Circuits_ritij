#! /mingw64/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "C:\msys64\mingw64\lib\ivl\system.vpi";
:vpi_module "C:\msys64\mingw64\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\msys64\mingw64\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\msys64\mingw64\lib\ivl\v2005_math.vpi";
:vpi_module "C:\msys64\mingw64\lib\ivl\va_math.vpi";
S_00000232d3548170 .scope module, "clock_gen" "clock_gen" 2 3;
 .timescale 0 0;
    .port_info 0 /OUTPUT 1 "clock";
v00000232d3548300_0 .var "clock", 0 0;
v00000232d35483a0_0 .var/i "i", 31 0;
    .scope S_00000232d3548170;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000232d3548300_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v00000232d35483a0_0, 0, 32;
    %end;
    .thread T_0;
    .scope S_00000232d3548170;
T_1 ;
    %delay 5, 0;
    %load/vec4 v00000232d3548300_0;
    %inv;
    %store/vec4 v00000232d3548300_0, 0, 1;
    %load/vec4 v00000232d35483a0_0;
    %addi 1, 0, 32;
    %store/vec4 v00000232d35483a0_0, 0, 32;
    %vpi_call 2 13 "$display", "%0t clock = %b, i = %0d", $time, v00000232d3548300_0, " " {0 0 0};
    %load/vec4 v00000232d35483a0_0;
    %cmpi/s 36, 0, 32;
    %flag_inv 5; GE is !LT
    %jmp/0xz  T_1.0, 5;
    %vpi_call 2 15 "$display", "%0t Reached %0d toggles, finishing simulation", $time, v00000232d35483a0_0 {0 0 0};
    %vpi_call 2 16 "$finish" {0 0 0};
T_1.0 ;
    %jmp T_1;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "clock_gen.v";
